{
  "name": "gulfrabit/storefront",
  "type": "project",
  "description": "GulfRabit — premium imports for Bangladesh. Laravel backend, one module per feature.",
  "keywords": [
    "laravel",
    "ecommerce",
    "bangladesh",
    "modular"
  ],
  "license": "proprietary",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^12.0",
    "laravel/sanctum": "^4.0"
  },
  "require-dev": {
    "fakerphp/faker": "^1.23",
    "laravel/pint": "^1.18",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.5",
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/",
      "Modules\\Accounting\\": "modules/accounting/backend/",
      "Modules\\Admin\\": "modules/admin/backend/",
      "Modules\\Cms\\": "modules/cms/backend/",
      "Modules\\Courier\\": "modules/courier/backend/",
      "Modules\\Inventory\\": "modules/inventory/backend/",
      "Modules\\Bundle\\": "modules/bundle/backend/",
      "Modules\\Delivery\\": "modules/delivery/backend/",
      "Modules\\Catalog\\": "modules/catalog/backend/",
      "Modules\\Media\\": "modules/media/backend/",
      "Modules\\Highlights\\": "modules/highlights/backend/",
      "Modules\\Cart\\": "modules/cart/backend/",
      "Modules\\Checkout\\": "modules/checkout/backend/",
      "Modules\\Auth\\": "modules/auth/backend/",
      "Modules\\Account\\": "modules/account/backend/",
      "Modules\\B2b\\": "modules/b2b/backend/",
      "Modules\\Deals\\": "modules/deals/backend/",
      "Modules\\Content\\": "modules/content/backend/",
      "Modules\\Marketing\\": "modules/marketing/backend/",
      "Modules\\Payments\\": "modules/payments/backend/",
      "Modules\\Sms\\": "modules/sms/backend/",
      "Modules\\Theme\\": "modules/theme/backend/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "@php artisan package:discover --ansi"
    ],
    "lint": "pint",
    "test": "@php artisan test"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
