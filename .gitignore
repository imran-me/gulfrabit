# ── GulfRabit / OS & editor noise ────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
*.log

# ── Editor / IDE ─────────────────────────────────────────────────
.vscode/
.idea/
*.swp

# ── Node / future build tooling (not used yet, reserved) ─────────
node_modules/
dist/
.cache/
npm-debug.log*

# ── Environment / secrets (for the future Laravel backend) ───────
.env
.env.local
*.local.php

# ── Keep the source logo out of the repo root once copied ────────
# (working copy lives in assets/logo/) — comment out if you want it tracked.

# ---- Laravel (see BACKEND.md) ----------------------------------------
/vendor/
/node_modules/
/storage/*.key
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/logs/*
/bootstrap/cache/*
/public/storage
.env
.env.backup
.env.production
.phpunit.result.cache
_laravel-skeleton/

# Merchant-uploaded images. The files are data, like the database — they belong
# on the server, not in the repo, and deploy.sh's `git reset --hard` leaves
# untracked files alone so they survive every deploy.
# The .htaccess IS tracked: it is what stops anything in here executing, and a
# fresh clone must never produce an uploads folder without it.
/uploads/*
!/uploads/.htaccess

# Python bytecode from the author-time tools in tools/.
__pycache__/
*.pyc
