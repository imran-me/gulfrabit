# GulfRabit — Apache config for Hostinger.
#
# THE ROUTING MODEL, because it is not the usual Laravel one:
#
#   The storefront is a STATIC site living at the repo root (index.html,
#   modules/, shared/, assets/). Apache serves it directly.
#   Laravel is ONLY the JSON API. Just /api/* reaches public/index.php.
#
# So this repo root is the document root — point public_html at it (or clone the
# repo as public_html). Do NOT blanket-rewrite everything into public/: that is
# the standard Laravel setup and it would 404 the entire storefront, because
# there is no index.html inside public/.
#
# The trade-off of having the app root be the web root is that the blocking
# rules at the bottom are load-bearing. They are tested by
# `python tools/htaccess-check.py`.

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Force HTTPS (Hostinger issues a free certificate).
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

    # --- The API, and only the API, goes to Laravel --------------------
    RewriteRule ^api(/.*)?$ public/index.php [L,QSA]

    # Laravel's health check.
    RewriteRule ^up$ public/index.php [L,QSA]

    # --- Readable URLs -------------------------------------------------
    # /product/ajwa-dates-madinah-select  ->  modules/catalog/product.html?id=…
    #
    # The pages are unchanged: each still reads its parameter from the query
    # string, so this is a rename of the ADDRESS and nothing else. The page
    # resolves ?id= against a slug or a SKU, which is why the old
    # /modules/catalog/product.html?id=gr-1101 keeps working — it is a real
    # file and the pass-through rule below serves it exactly as it always has.
    #
    # ADDITIVE ON PURPOSE. Nothing here redirects, rewrites away, or breaks a
    # single existing URL: it only makes new ones start working. Every link,
    # ad, bookmark, QR code and indexed page in the world keeps resolving. The
    # redirects that eventually retire the old form are a later, separate step
    # taken only once these are proven on the server.
    #
    # QSA so /product/x?utm_source=fb keeps its UTMs — attribution rides the
    # landing URL and dropping it would blind the ad reporting.
    # The character classes are deliberately narrow: a slug is lowercase
    # letters, digits and hyphens, and anything else should fall through to the
    # 404 rather than be handed to a page as a parameter.
    RewriteRule ^product/([A-Za-z0-9._-]+)/?$ modules/catalog/product.html?id=$1 [L,QSA]
    RewriteRule ^category/([a-z0-9-]+)/?$ modules/catalog/category.html?slug=$1 [L,QSA]
    # The whole catalogue — the same page with no category chosen. Its own name
    # rather than a bare /category/, which reads like a missing argument.
    RewriteRule ^shop/?$ modules/catalog/category.html [L,QSA]
    RewriteRule ^search/?$ modules/catalog/search-results.html [L,QSA]

    # The flat pages. One line each, and each one is a name a person could say
    # over a phone — which is the entire point of the exercise.
    RewriteRule ^cart/?$ modules/cart/cart.html [L,QSA]
    RewriteRule ^checkout/?$ modules/checkout/checkout.html [L,QSA]
    RewriteRule ^buy/?$ modules/checkout/express.html [L,QSA]
    RewriteRule ^order-confirmed/?$ modules/checkout/order-confirmation.html [L,QSA]
    RewriteRule ^track/?$ modules/account/track.html [L,QSA]
    RewriteRule ^deals/?$ modules/deals/deals.html [L,QSA]
    RewriteRule ^wholesale/?$ modules/b2b/b2b-industrial.html [L,QSA]

    RewriteRule ^about/?$ modules/content/about.html [L,QSA]
    RewriteRule ^contact/?$ modules/content/contact.html [L,QSA]
    RewriteRule ^sourcing/?$ modules/content/sourcing.html [L,QSA]
    RewriteRule ^faq/?$ modules/content/faq.html [L,QSA]
    RewriteRule ^shipping-returns/?$ modules/content/shipping-returns.html [L,QSA]
    RewriteRule ^privacy/?$ modules/content/privacy.html [L,QSA]
    RewriteRule ^terms/?$ modules/content/terms.html [L,QSA]

    RewriteRule ^login/?$ modules/auth/login.html [L,QSA]
    RewriteRule ^register/?$ modules/auth/register.html [L,QSA]
    RewriteRule ^account/?$ modules/account/dashboard.html [L,QSA]
    RewriteRule ^account/orders/?$ modules/account/orders.html [L,QSA]
    RewriteRule ^account/addresses/?$ modules/account/addresses.html [L,QSA]
    RewriteRule ^wishlist/?$ modules/account/wishlist.html [L,QSA]

    # --- Everything else is the static storefront ----------------------
    # Real files and directories are served as-is. Anything else falls
    # through to the 404 page below rather than to Laravel, which has no
    # page routes at all (see routes/web.php).
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]
</IfModule>

ErrorDocument 404 /404.html

# ---------------------------------------------------------------------------
# Block application internals.
#
# CAREFUL with modules/: that folder is NOT purely server-side. Each module's
# backend/api.js is the frontend data seam and is imported by the browser, so
# denying modules/*/backend/ wholesale takes the storefront down. The negative
# lookahead denies everything under backend/ EXCEPT api.js.
#
# The module datasets (modules/*/data/*.json) must stay reachable too — the
# storefront fetches them directly until the API is live.
# ---------------------------------------------------------------------------

RedirectMatch 404 ^/(app|bootstrap|config|database|storage|vendor|tools|research)/
RedirectMatch 404 ^/modules/[^/]+/backend/(?!api\.js$).*$
RedirectMatch 404 ^/modules/[^/]+/_fragments/
RedirectMatch 404 ^/(composer\.(json|lock)|artisan|phpunit\.xml|context\.md|BACKEND\.md|CONVENTIONS\.md|DEPLOY-HOSTINGER\.md)$

<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<FilesMatch "\.(md|lock|sql|ini|yml|yaml|log)$">
    Require all denied
</FilesMatch>

# ---- MIME types --------------------------------------------------------
# Not every Apache build knows font/woff2, and serving it as
# application/octet-stream costs the browser's font-specific optimisations.
<IfModule mod_mime.c>
    AddType font/woff2 .woff2
    AddType image/svg+xml .svg
    AddType application/manifest+json .webmanifest
</IfModule>

# ---- Compression -------------------------------------------------------
# Shajgoj serves 411 KB of JS completely uncompressed because its nginx
# gzip_types omits application/javascript. Do not repeat that.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/json image/svg+xml
</IfModule>

# ---- Caching -----------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    # HTML revalidates: tools/assemble.py rewrites pages on every build.
    ExpiresByType text/html "access plus 0 seconds"
    # JSON is the mock data layer and changes with the catalog — keep it short.
    ExpiresByType application/json "access plus 1 hour"
    # CSS and JS are handled by the Cache-Control block below instead, keyed on
    # whether the URL carries a content hash. Leaving an Expires here as well
    # would give two answers to the same question.
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# ---- Script and stylesheet caching -------------------------------------
# Keyed on whether the URL carries a content hash, not on file type.
#
# tools/assemble.py appends ?v=<8 hex> to every CSS and JS file it links, where
# the hash is of that file's own bytes. Such a URL is content-addressed: it can
# never point at different code than it did before, so it is safe to cache for
# a year and it costs nothing when the file changes, because the URL changes
# with it.
#
# Everything else — chiefly modules loaded by a runtime `import()`, whose
# specifier is written in source and cannot carry a build hash — must
# revalidate. A blanket 7-day rule used to cover those, and it is how a shipped
# admin screen stayed invisible in the browser for a week while being present
# on the server. `no-cache` still allows a 304, so the cost is one conditional
# request, not a re-download.
<IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=31536000, immutable" "expr=%{QUERY_STRING} =~ /(^|&)v=[0-9a-f]{8}($|&)/"
    Header set Cache-Control "no-cache" "expr=%{REQUEST_URI} =~ /\.(js|css)$/ && ! %{QUERY_STRING} =~ /(^|&)v=[0-9a-f]{8}($|&)/"
</IfModule>

# ---- Security headers --------------------------------------------------
# None of Shajgoj, Ghorer Bazar or Daraz ship a CSP. It is cheap to get right
# and is a genuine differentiator on a site taking bKash and card payments.
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"

    # Opener isolation. `allow-popups` because bKash and the courier trackers
    # open in a new window and need to keep their reference back.
    Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"

    # Nothing here is a Flash or Silverlight policy target. Cheap, and it stops
    # a crossdomain.xml uploaded to the media library ever meaning anything.
    Header always set X-Permitted-Cross-Domain-Policies "none"

    # HSTS. The redirect at the top of this file already forces HTTPS; this
    # stops the first request of a session being made in cleartext at all.
    #
    # 180 days rather than a year, and NO includeSubDomains or preload. HSTS is
    # the one header that cannot be taken back quickly — a browser that has
    # seen it refuses plain HTTP for the full duration whatever the server
    # later says. Six months is long enough to be worth having and short
    # enough to recover from. `includeSubDomains` is omitted because it would
    # cover subdomains that do not exist yet and may not have certificates.
    Header always set Strict-Transport-Security "max-age=15552000"

    # ---- Content-Security-Policy --------------------------------------
    #
    # BE CLEAR ABOUT WHAT THIS DOES AND DOES NOT BUY, because a CSP with
    # 'unsafe-inline' in script-src is often mistaken for XSS protection and
    # this one is not that.
    #
    # WHAT IT STOPS:
    #   - a script loaded from a host not named here (the usual outcome of a
    #     compromised dependency or an injected <script src>)
    #   - <base> injection, which silently repoints every relative URL
    #   - a form posted to an attacker's domain — form-action is the one that
    #     matters most on a checkout
    #   - plugins, embeds, and framing by anyone else
    #
    # WHAT IT DOES NOT STOP: injected INLINE script. 'unsafe-inline' is
    # currently required because the pages carry an inline no-js remover, two
    # JSON-LD blocks per page, and 77 style="" attributes on the home page
    # alone. Hashing would need every one of those enumerated and kept in step.
    #
    # Removing those three is now the ONLY thing between this policy and one
    # that stops injected script outright.
    #
    # script-src IS 'self' AND NOTHING ELSE as of 2026-07-30. 'unsafe-eval'
    # went with cdn.tailwindcss.com — a CSS compiler that ran in every
    # visitor's browser before first paint to supply one utility class.
    # cdn.jsdelivr.net went too: only Bootstrap's STYLESHEET is served from
    # there, so it never belonged in the script list at all. The site now
    # executes no third-party JavaScript.
    #
    # NOTE THE TWO FONTSHARE HOSTS. api.fontshare.com serves the @font-face
    # CSS; the font FILES come from cdn.fontshare.com. Listing only the first —
    # which is the one written in the page — blocks the display typeface on
    # every page, and the failure is a silent fallback to a system font rather
    # than an error anybody notices. Verified by fetching the stylesheet.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://api.fontshare.com; font-src 'self' https://fonts.gstatic.com https://cdn.fontshare.com data:; img-src 'self' data: blob:; connect-src 'self'; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; upgrade-insecure-requests"
</IfModule>

Options -Indexes
