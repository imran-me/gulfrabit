APP_NAME=GulfRabit
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Dhaka
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Hostinger: DB_HOST is usually 'localhost'; database name and user are the
# ones hPanel generates (they carry a uXXXXXXXX_ prefix).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gulfrabit
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

# Shared hosting has no Redis by default — database/file drivers are the safe
# choice on Hostinger unless you have added Redis yourself.
CACHE_STORE=database
QUEUE_CONNECTION=database

# The storefront is static and served from public/. Set this to the real origin
# in production so the cart cookie and CORS behave.
SANCTUM_STATEFUL_DOMAINS=localhost:8000

# ---- The first staff account --------------------------------------------
# Read ONLY by AdminUserSeeder, and only the first time — it creates one owner
# and leaves an existing one untouched, so re-running it is safe.
#
# This is the bootstrap, NOT the way you add staff. Everybody after this first
# owner is created at /admin/staff in the browser. The seeder exists because
# that screen is owner-only, so somebody has to exist before it can be opened.
#
# ADMIN_EMAIL is required — the seeder refuses to run without it rather than
# inventing an address nobody is watching. It is a USERNAME, not a mailbox:
# nothing in this panel ever sends mail, and there is no reset-by-email flow, so
# the address does not have to be reachable. A Gmail address is fine.
#
# Leave ADMIN_PASSWORD BLANK. The seeder then generates a strong one and prints
# it once, which is the only way to be sure a weak admin password never exists.
# Set it only if you have a specific reason, and delete it from this file after.
ADMIN_EMAIL=
ADMIN_NAME=Owner
ADMIN_PASSWORD=

# Transactional SMS (modules/sms). Absent = no SMS, silently: a status change
# must never fail because the message riding on it is unconfigured.
#
#   log        writes what WOULD be sent and sends nothing. The order screen's
#              message box works fully in this mode — thread, templates and the
#              segment counter — so the whole flow can be rehearsed before any
#              credit is bought. Note that the log line is written at INFO, so
#              LOG_LEVEL=error hides it; the sms_logs table records it either way.
#   bulksmsbd  really sends. Needs both keys below.
SMS_GATEWAY=log
SMS_API_KEY=
SMS_SENDER_ID=
